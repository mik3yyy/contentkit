generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String           @id @default(cuid())
  email              String           @unique
  name               String?
  image              String?
  password           String?
  hasPaid            Boolean          @default(false)
  paidAt             DateTime?
  stripePaymentId    String?
  stripeCustomerId   String?
  subscriptionId     String?
  subscriptionStatus String? // active | past_due | canceled | null
  currentPeriodEnd   DateTime?
  credits            Int              @default(0)
  generateOnboarding Json? // answers from the /generate first-visit questions; null until completed
  favorites          Favorite[]
  downloads          Download[]
  generationJobs     GenerationJob[]
  createdAt          DateTime         @default(now())
}

model Content {
  id            String     @id @default(cuid())
  title         String
  type          String
  niche         String
  r2Key         String     @unique
  thumbnailUrl  String?
  fileSizeBytes Int?
  durationSeconds Int?
  tags          String[]
  description   String?
  role          String? // standalone | broll | null
  favorites     Favorite[]
  downloads     Download[]
  generationJobs GenerationJob[]
  createdAt     DateTime   @default(now())
}

model GenerationJob {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mode         String // "niche-only" | "clipping" | "script"
  status       String // pending | processing | completed | failed
  niche        String?
  contentId    String?
  content      Content? @relation(fields: [contentId], references: [id], onDelete: SetNull)
  creditsCost  Int
  sourceR2Key  String? // user-uploaded source video (clipping mode)
  outputR2Key  String? // rendered result (clipping/script mode)
  selections   Json? // ordered list of clip/broll segments used in the render, editable before finalizing
  script       String? // user-entered script text (script mode)
  voiceover    Boolean  @default(false) // whether to synthesize + mux an AI voiceover track (script mode)
  errorMessage String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  contentId String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, contentId])
}

model Download {
  id        String   @id @default(cuid())
  userId    String
  contentId String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model PasswordReset {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model AnalyticsEvent {
  id        String   @id @default(cuid())
  vid       String   // persistent visitor ID (localStorage UUID — unique browser)
  sid       String   // session ID (sessionStorage UUID — unique tab session)
  event     String   // page_view | pricing_view | cta_click | checkout_start | payment_success | signup_complete | signin
  page      String?  // URL pathname
  ref       String?  // document.referrer
  ua        String?  // user agent
  meta      String?  // JSON string for extra data (email after payment, etc.)
  createdAt DateTime @default(now())

  @@index([event])
  @@index([vid])
  @@index([createdAt])
}
